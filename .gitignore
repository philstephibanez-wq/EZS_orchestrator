__pycache__/
*.py[cod]
.env.local
.pytest_cache/
.coverage
htmlcov/
runtime/*
!runtime/.gitkeep
logs/*
!logs/.gitkeep
*.log

# Symfony V2 root runtime
/vendor/
/var/
/.env.local
/.env.*.local

# Protection transitoire du runtime Symfony historique.
# Ces règles DOIVENT survivre à la suppression future de web/.gitignore.
/web/vendor/
/web/var/
/web/.env.local
/web/.env.*.local
/web/config/reference.php
