{
    admin off
    auto_https off
}

# v2.a0 ROOT PREVIEW ONLY. No active service or automatic activation.
# Dedicated loopback ports: does NOT take over existing 8790/8791.
http://127.0.0.1:8890 {
    bind 127.0.0.1
    root * H:/EZS_orchestrator/public
    encode gzip
    php_fastcgi 127.0.0.1:8891 {
        capture_stderr
    }
    file_server
    header X-Content-Type-Options nosniff
    header Cache-Control "no-store"
}
