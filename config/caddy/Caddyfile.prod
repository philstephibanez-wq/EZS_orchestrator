{
    auto_https off
    admin 127.0.0.1:2020
}

# PROD edge only. Do not activate until runtime/backend migration is verified.
# Cloudflare and Google OAuth keep the existing public hostname and port.
http://127.0.0.1:8501 {
    bind 127.0.0.1
    @media path /media/*
    handle @media {
        forward_auth 127.0.0.1:8510 {
            uri /internal/media/auth
        }
        root * H:/EZScore/var/storage/stems
        uri strip_prefix /media
        header Cache-Control "private, max-age=3600"
        file_server
    }
    handle {
        reverse_proxy 127.0.0.1:8510 {
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Port 443
            header_up X-Forwarded-Host {http.request.host}
        }
    }
}
