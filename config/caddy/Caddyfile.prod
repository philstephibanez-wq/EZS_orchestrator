{
    admin 127.0.0.1:2020
    auto_https off
}

# EZScore PROD : une SEULE instance Caddy, trois facades loopback.
# Le hostname public et le port 8501 restent inchanges pour Cloudflare / Google SSO.
:8501 {
    bind 127.0.0.1
    @media path /media/*
    handle @media {
        forward_auth 127.0.0.1:8510 {
            uri /internal/media/auth
        }
        root * H:/EZScore/var/storage/stems
        uri strip_prefix /media
        header Cache-Control "private, max-age=3600"
        file_server
    }
    handle {
        reverse_proxy 127.0.0.1:8510 {
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Port 443
            header_up X-Forwarded-Host {http.request.host}
        }
    }
}

# Gateway PROD local : PHP FastCGI, configuration maintenance et protocole v3.
:8510 {
    bind 127.0.0.1
    root * H:/EZS_orchestrator/runtime_components/prod_gateway_php
    route {
        rewrite * /router.php
        php_fastcgi 127.0.0.1:18515 {
            header_up X-EZS-Original-URI {http.request.orig_uri}
            header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
            capture_stderr
        }
    }
}

# Backend Symfony PROD interne, jamais expose directement sur Internet.
:8511 {
    bind 127.0.0.1
    root * H:/EZScore/public
    encode gzip
    php_fastcgi 127.0.0.1:8512 {
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Port 443
        capture_stderr
    }
    file_server
    header X-Content-Type-Options nosniff
    header Cache-Control "no-store"
}
