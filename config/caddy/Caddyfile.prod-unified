{
    auto_https off
    admin 127.0.0.1:2020
}

# One Caddy PROD process, three loopback HTTP sites; two PHP FastCGI workers.
# Public :8501, gateway :8510, Symfony internal :8511.

# Cloudflare and Google OAuth keep the existing public hostname and port.
:8501 {
    bind 127.0.0.1
    @media path /media/*
    handle @media {
        forward_auth 127.0.0.1:8510 {
            uri /internal/media/auth
        }
        root * H:/EZScore/var/storage/stems
        uri strip_prefix /media
        header Cache-Control "private, max-age=3600"
        file_server
    }
    handle {
        reverse_proxy 127.0.0.1:8510 {
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Port 443
            header_up X-Forwarded-Host {http.request.host}
        }
    }
}

# Production gateway PHP, local only. Caddy public 8501 remains unchanged.
:8510 {
    bind 127.0.0.1
    root * H:/EZS_orchestrator/runtime_components/prod_gateway_php
    route {
        rewrite * /router.php
        php_fastcgi 127.0.0.1:18515 {
            header_up X-EZS-Original-URI {http.request.orig_uri}
            header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
            capture_stderr
        }
    }
}

# Internal PROD HTTP facade for Gateway :8510.
# Must remain loopback only, never publicly reachable.
:8511 {
    bind 127.0.0.1
    root * H:/EZScore/public
    encode gzip
    php_fastcgi 127.0.0.1:8512 {
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Port 443
        capture_stderr
    }
    file_server
    header X-Content-Type-Options nosniff
    header Cache-Control "no-store"
}
