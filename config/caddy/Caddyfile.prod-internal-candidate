{
    admin 127.0.0.1:2022
    auto_https off
}

# Internal PROD HTTP facade for Gateway :8510.
# Must remain loopback only, never publicly reachable.
:8511 {
    bind 127.0.0.1
    root * H:/EZScore/public
    encode gzip
    php_fastcgi 127.0.0.1:8512 {
        capture_stderr
    }
    file_server
    header X-Content-Type-Options nosniff
    header Cache-Control "no-store"
}
