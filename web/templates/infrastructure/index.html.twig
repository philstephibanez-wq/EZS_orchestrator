<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>EZS Orchestrator V2</title>
</head>
<body>
    <main>
        <h1>EZS Orchestrator V2</h1>
        <p>Environnements autorisés. Consultation uniquement : aucun service démarré depuis cette page.</p>
        <table>
            <thead>
                <tr><th>Composant</th><th>Environnement</th><th>Maintenance</th></tr>
            </thead>
            <tbody>
                {% for environment in environments %}
                    <tr>
                        <td>{{ environment.component }}</td>
                        <td>{{ environment.environment|upper }}</td>
                        <td>{{ environment.maintenance ? 'Disponible' : 'Non applicable' }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </main>
</body>
</html>
