<!DOCTYPE html>
<html lang="fr" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}EZS Orchestrator{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/assets/ezs-infrastructure.css">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="/assets/ezs-gpu-monitor.js" defer></script>
    {% block page_scripts %}{% endblock %}
    {% if app.request.host in ['127.0.0.1', 'localhost'] and app.request.port == 8790 %}
        <link rel="stylesheet" href="/assets/ezs-debug-layout.css?v={{ orchestrator_version|url_encode }}">
        <script src="/assets/ezs-dev-debug.js?v={{ orchestrator_version|url_encode }}" defer></script>
    {% endif %}
</head>
<body>
    <header class="navbar navbar-dark bg-dark">
        <div class="container-fluid">
            <span class="navbar-brand mb-0 h1">EZS Orchestrator <small class="text-secondary">v{{ orchestrator_version }}</small></span>
            <span class="badge text-bg-secondary">DEV · Consultation</span>
        </div>
    </header>
    {% include 'infrastructure/_gpu_monitor.html.twig' %}
    <nav class="ezs-nav" aria-label="Navigation principale">
        <a href="/" {% if active_page == 'infrastructure' %}aria-current="page"{% endif %}>Infrastructure</a>
        <a href="/jobs" {% if active_page == 'jobs' %}aria-current="page"{% endif %}>Files &amp; Jobs · en migration</a>
        <span>Déploiements · en migration</span>
    </nav>
    {% block content %}{% endblock %}
    {% if app.request.host in ['127.0.0.1', 'localhost'] and app.request.port == 8790 %}
        <aside class="container-fluid pb-3 ezs-debug-region" aria-label="Diagnostic technique DEV">
            <details id="ezs-debug-panel" class="border border-secondary rounded p-3">
                <summary class="fw-semibold" style="cursor: pointer">Diagnostic technique DEV — ouvrir / masquer</summary>
                <div class="d-flex flex-wrap align-items-center gap-2 mt-3 mb-2">
                    <button type="button" class="btn btn-outline-info btn-sm" id="ezs-debug-refresh">Actualiser</button>
                    <button type="button" class="btn btn-outline-light btn-sm" id="ezs-debug-copy">Copier le diagnostic complet</button>
                    <span id="ezs-debug-spinner" class="spinner-border spinner-border-sm text-info d-none" role="status" aria-label="Collecte du diagnostic en cours"></span>
                    <span role="status" aria-live="polite" id="ezs-debug-status" class="small text-body-secondary">Diagnostic non initialisé</span>
                </div>
                <pre id="ezs-debug-output" tabindex="0" class="p-3 border rounded small ezs-debug-report">{ "status": "NON_COLLECTE" }</pre>
                <p class="small text-body-secondary mb-0">Dumps JSON de sources GET et DOM, champs sensibles masqués. Aucun START/STOP n'est déclenché.</p>
            </details>
        </aside>
    {% endif %}
</body>
</html>
