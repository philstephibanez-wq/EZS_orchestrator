{% extends 'layout/base.html.twig' %}

{% block title %}
    EZS Orchestrator — Files &amp; Jobs
{% endblock %}

{% block content %}
    <main class="container-fluid py-4 ezs-main">
        <div class="ezs-statusline mb-3">
            <strong>Files &amp; Jobs</strong>
            <span class="text-body-secondary">Historique V1 en lecture seule · Snapshots result.json uniquement</span>
        </div>

        <div class="alert alert-secondary" role="status">
            Ces tentatives sont archivées et ne représentent pas l'état actuel des files.
            Aucun job n'est exécuté ou réclamé depuis cette page.
        </div>

<section class="card mb-3" aria-labelledby="registry-title">
            <div class="card-header"><strong id="registry-title">Registre Orchestrator — lecture seule</strong></div>
            <div class="card-body">
                {% if global_queue.available %}
                    <p class="text-body-secondary">Jobs déjà inscrits au registre Orchestrator ({{ global_queue.jobs|length }} affiché(s), limite 100). Ce registre n'atteste pas encore le dispatch global.</p>
                    <div class="table-responsive"><table class="table table-dark table-sm">
                        <thead><tr><th>Cible enregistrée</th><th>Job</th><th>Type</th><th>Priorité</th><th>État</th><th>Mis à jour</th></tr></thead>
                        <tbody>{% for job in global_queue.jobs %}
                            <tr><td>{{ job.target }}</td><td>{{ job.job_id }}</td><td>{{ job.kind }}</td><td>{{ job.priority }}</td><td>{{ job.state }}</td><td>{{ job.updated_at }}</td></tr>
                        {% else %}<tr><td colspan="6">Aucun job inscrit au registre. Les jobs externes peuvent exister.</td></tr>{% endfor %}</tbody>
                    </table></div>
                {% else %}
                    <p class="mb-0 text-body-secondary">Registre non consultable : {{ global_queue.reason }}. Aucune conclusion sur les jobs LAB ou Assistant.</p>
                {% endif %}
            </div>
        </section>

        <section class="card mb-3">
            <div class="card-header">
                <strong>Queue globale — observation partielle</strong>
                {% if lab_queue.connected %}
                    <span class="badge text-bg-success">Connectée</span>
                {% else %}
                    <span class="badge text-bg-secondary">Non connectée</span>
                {% endif %}
            </div>
            <div class="card-body">
                {% if lab_queue.connected %}
                    <p>Jobs retournés par la sonde LAB (vue partielle, pas la queue globale complète) : {{ lab_queue.jobs|length }} (affichage limité à 100).</p>
                    <div class="table-responsive">
                        <table class="table table-dark table-sm">
                            <thead>
                                <tr><th>Provenance</th><th>Job</th><th>Type</th><th>État déclaré par LAB</th><th>Priorité</th></tr>
                            </thead>
                            <tbody>
                                {% for job in lab_queue.jobs %}
                                    <tr>
                                        <td>LAB (sonde)</td><td>{{ job.id }}</td>
                                        <td>{{ job.kind }}</td>
                                        <td>{{ job.status }}</td>
                                        <td>{{ job.priority ?? '—' }}</td>
                                    </tr>
                                {% else %}
                                    <tr><td colspan="5">Aucun job dans la réponse de queue LAB.</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <p class="mb-0">Lecture LAB indisponible : {{ lab_queue.reason }}. Les archives ci-dessous restent consultables.</p>
                {% endif %}
                <p class="text-body-secondary mb-0">La queue unique de l’Orchestrator n’est pas encore exposée intégralement dans cette vue. L’absence d’un job Assistant ici ne signifie pas qu’il est absent de la queue. Aucun claim ni dispatch depuis cette vue.</p>
            </div>
        </section>

        <section class="card mb-3">
            <div class="card-header">
                <strong>Dernières tentatives archivées</strong>
                <span class="text-body-secondary">({{ history|length }})</span>
            </div>
            <div class="table-responsive">
                <table class="table table-dark table-striped table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Cible</th>
                            <th>Job</th>
                            <th>Run</th>
                            <th>Type</th>
                            <th>Chanson</th>
                            <th>État archivé</th>
                            <th>RC analyse</th>
                            <th>Finalisation</th>
                            <th>Horodatage fichier</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in history %}
                            <tr>
                                <td>{{ item.target }}</td>
                                <td>{{ item.job_id }}</td>
                                <td>{{ item.run }}</td>
                                <td>{{ item.kind }}</td>
                                <td>{{ item.song_title ?: (item.song_id ?? '—') }}</td>
                                <td>
                                    {% if item.state == 'completed' %}
                                        <span class="badge text-bg-success">Terminé</span>
                                    {% elseif item.state == 'failed' %}
                                        <span class="badge text-bg-danger">Échec analyse</span>
                                    {% elseif item.state == 'finalize_error' %}
                                        <span class="badge text-bg-warning">Erreur finalisation</span>
                                    {% elseif item.state == 'running' %}
                                        <span class="badge text-bg-primary">En cours (archive)</span>
                                    {% else %}
                                        <span class="badge text-bg-secondary">En attente (archive)</span>
                                    {% endif %}
                                </td>
                                <td>{{ item.analysis_returncode ?? '—' }}</td>
                                <td>{{ item.finalize_status ?: '—' }}</td>
                                <td>{{ item.timestamp }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="9" class="text-body-secondary">
                                    Aucun result.json historique trouvé. Cela ne signifie pas que les files sont vides.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

        <p class="text-body-secondary">
            Lecture locale sans accès BDD externe ni lecture execution.log.
            Les files temps réel et les workers Symfony restent en migration.
        </p>
    </main>
{% endblock %}
