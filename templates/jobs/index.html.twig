{% extends 'layout/base.html.twig' %}

{% block title %}EZS Orchestrator — Files &amp; Jobs{% endblock %}

{% block content %}
<main class="container-fluid py-4 ezs-main">
    <div class="ezs-statusline mb-3 d-flex justify-content-between align-items-center">
        <span><strong>Files &amp; Jobs</strong> — file globale unique et historique distinct</span>
        <span class="text-body-secondary">Actualisation toutes les 15 s (onglet visible)</span>
    </div>

    <section class="card mb-3" aria-labelledby="queue-title">
        <div class="card-header d-flex justify-content-between">
            <strong id="queue-title">Queue globale — Orchestrator (autorité)</strong>
            <span class="badge {{ global_queue.available ? 'text-bg-success' : 'text-bg-secondary' }}">{{ global_queue.available ? 'Base accessible' : 'Indisponible' }}</span>
        </div>
        <div class="card-body">
            {% if global_queue.available %}
                <p class="text-body-secondary">Jobs admis dans la queue canonique SQLite (100 maximum). Un seul job est autorisé à la fois, dans l’ordre des demandes.</p>
                <p><strong>{{ global_queue.jobs|length }}</strong> jobs affichés
                    — en attente : <strong>{{ global_queue.counts.queued }}</strong>
                    — en cours : <strong>{{ global_queue.counts.running }}</strong>
                    — terminés : <strong>{{ global_queue.counts.completed }}</strong>
                    — échoués : <strong>{{ global_queue.counts.failed }}</strong>
                    — annulés : <strong>{{ global_queue.counts.cancelled|default(0) }}</strong>

                </p>
                <div class="table-responsive">
                    <table class="table table-dark table-sm align-middle mb-0">
                        <thead><tr>
                            <th>Job</th><th>Provenance</th><th>Référence source</th><th>Type</th><th>État</th><th>Progression</th><th>Phase</th><th>Dernier événement</th>
                        </tr></thead>
                        <tbody>
                        {% for job in global_queue.jobs %}
                            <tr>
                                <td>{{ job.id }}</td><td>{{ job.producer }}</td><td>{{ job.external_id }}</td>
                                <td>{{ job.kind }}</td>
                                <td>

                                    {% if job.state == 'completed' %}<span class="badge text-bg-success">Terminé</span>
                                    {% elseif job.state == 'failed' %}<span class="badge text-bg-danger">Erreur</span>
                                    {% elseif job.state == 'cancelled' %}<span class="badge text-bg-secondary">Annulé</span>
                                    {% elseif job.state == 'running' %}<span class="badge text-bg-primary">En cours</span>
                                    {% else %}<span class="badge text-bg-secondary">{{ job.state == 'queued' ? 'Demandé' : job.state }}</span>{% endif %}
                                </td>
                                <td>{% if job.state == 'completed' %}100 %{% elseif job.progress_percent is not null %}{{ job.progress_percent }} %{% elseif job.state == 'running' %}Indéterminée{% else %}—{% endif %}</td>
                                <td>{{ job.phase ?: '—' }}</td>
                                <td>{% if job.last_event_at is not null %}{{ job.last_event_at|date('d/m/Y H:i:s', 'Europe/Paris') }}{% else %}—{% endif %}</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="8">Aucun job admis dans la queue globale.</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <p class="mb-0 text-body-secondary">Queue globale inaccessible : {{ global_queue.reason }}. Aucun état n'est déduit.</p>
            {% endif %}
            <p class="text-body-secondary mt-2 mb-0">Lecture seule : aucun claim, dispatch, récupération ou changement d'état depuis cette page.</p>
        </div>
    </section>

    <section class="card mb-3">
        <div class="card-header"><strong>Dernières tentatives archivées V1</strong> <span class="text-body-secondary">({{ history|length }}) — archives, pas états courants</span></div>
        <div class="table-responsive">
            <table class="table table-dark table-striped table-sm align-middle mb-0">
                <thead><tr><th>Cible</th><th>Job</th><th>Run</th><th>Type</th><th>Chanson</th><th>État archivé</th><th>RC analyse</th><th>Finalisation</th><th>Horodatage fichier</th></tr></thead>
                <tbody>
                    {% for item in history %}
                    <tr>
                        <td>{{ item.target }}</td><td>{{ item.job_id }}</td><td>{{ item.run }}</td><td>{{ item.kind }}</td>
                        <td>{{ item.song_title ?: (item.song_id ?? '—') }}</td>
                        <td>{% if item.state == 'completed' %}<span class="badge text-bg-success">Terminé</span>
                        {% elseif item.state == 'failed' %}<span class="badge text-bg-danger">Échec analyse</span>
                        {% elseif item.state == 'finalize_error' %}<span class="badge text-bg-warning">Erreur finalisation</span>
                        {% elseif item.state == 'running' %}<span class="badge text-bg-primary">En cours (archive)</span>
                        {% else %}<span class="badge text-bg-secondary">En attente (archive)</span>{% endif %}</td>
                        <td>{{ item.analysis_returncode ?? '—' }}</td><td>{{ item.finalize_status ?: '—' }}</td><td>{{ item.timestamp }}</td>
                    </tr>
                    {% else %}<tr><td colspan="9" class="text-body-secondary">Aucun result.json historique trouvé.</td></tr>{% endfor %}
                </tbody>
            </table>
        </div>
    </section>
    <p class="text-body-secondary">Une seule file de pilotage, archives V1 distinctes. Aucun bouton d'exécution ni accès direct à la base LAB.</p>
</main>
<script>
(function () {
    window.setInterval(async function () {
        if (document.visibilityState !== 'visible') return;
        try {
            const response = await fetch('/jobs', {cache: 'no-store', credentials: 'same-origin'});
            if (!response.ok) return;
            const documentCopy = new DOMParser().parseFromString(await response.text(), 'text/html');
            for (const titleId of ['queue-title']) {
                const current = document.getElementById(titleId)?.closest('section');
                const replacement = documentCopy.getElementById(titleId)?.closest('section');
                if (current && replacement) current.replaceWith(document.importNode(replacement, true));
            }
        } catch (_) {
            // The previous successful snapshot remains visible; never reload the GPU monitor.
        }
    }, 15000);
}());
</script>
{% endblock %}
